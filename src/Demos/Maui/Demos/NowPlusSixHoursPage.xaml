<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MathConverter.Demo.Demos.NowPlusSixHoursPage"
             xmlns:math="http://hexinnovation.com/math"
             Title="Now Plus Six Hours"
             Padding="20"
             BindingContext="{Binding Source={RelativeSource Self}}">
    <VerticalStackLayout>
        <Label Text="{math:Convert '$`Six hours from now, the time will be {Now() + ConvertType(`6:00:00`, x):h\':\'mm\':\'ss tt}\\nWe bind to a property that updates every second, in order to update the string.`', x={Binding Source={x:Type x:TimeSpan}}, y={Binding OneSecondTimer}}" />
    </VerticalStackLayout>
</ContentPage>
